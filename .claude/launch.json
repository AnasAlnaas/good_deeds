{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "mobile", "run", "web", "--", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "mobile-web-local",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set EXPO_PUBLIC_API_URL=http://localhost:3000&& npm --prefix mobile run web -- --port 8082"],
      "port": 8082
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "server", "run", "dev"],
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "admin", "run", "dev"],
      "port": 5173
    }
  ]
}
