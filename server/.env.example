# Copy to .env for development. On the server machine, set these for real.

# Empty = PGlite in .data/pglite (development). Production needs a real Postgres:
# DATABASE_URL=postgres://gooddeeds:password@localhost:5432/gooddeeds
DATABASE_URL=

# Signs sign-in tokens. Production: a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# console = print sign-in codes in the server log (development). none = refuse until SMS is set up.
LOGIN_CODE_DELIVERY=console

PORT=3000

# Web origins allowed to call the API, comma-separated (admin panel, app web build). Empty = any origin.
CORS_ORIGINS=

# expo = send push notifications through Expo's push service (production default).
# console = print them in the server log (development default). none = off.
PUSH_DELIVERY=
# Only if "enhanced push security" is turned on in the EAS dashboard.
EXPO_ACCESS_TOKEN=

# Times written into notifications use this zone. Empty = Africa/Tripoli.
TIME_ZONE=

# Lets an outside scheduler call POST /api/internal/tick. Empty = that endpoint is off.
CRON_SECRET=
