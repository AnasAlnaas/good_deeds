{
  "name": "good-deeds-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "typecheck": "tsc --noEmit",
    "check:api": "tsx scripts/check-api.ts && tsx scripts/check-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "cf:db": "tsx scripts/local-postgres.ts",
    "cf:dev": "npm --prefix ../admin run build && wrangler dev",
    "cf:deploy": "npm --prefix ../admin run build && wrangler deploy"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.15",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@hono/node-server": "^2.1.5",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
