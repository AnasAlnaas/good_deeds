{
  "name": "good-deeds-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "typecheck": "tsc --noEmit",
    "check:api": "tsx scripts/check-api.ts && tsx scripts/check-admin.ts && tsx scripts/check-online.ts && tsx scripts/check-reminders.ts && tsx scripts/check-waitlist.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "set-password": "tsx scripts/set-password.ts",
    "change-phone": "tsx scripts/change-phone.ts",
    "db:reset": "tsx scripts/reset-database.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@hono/node-server": "^2.1.5",
    "@vercel/functions": "^3.10.4",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
