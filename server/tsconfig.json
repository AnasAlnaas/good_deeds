{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    // Explicit, so builds that compile from the repository root (Vercel, for ../shared) still find them.
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["index.ts", "src/**/*.ts", "scripts/**/*.ts", "drizzle.config.ts", "../shared/**/*.ts"]
}
