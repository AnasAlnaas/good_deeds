{
  "expo": {
    "name": "Good Deeds",
    "slug": "good-deeds",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "gooddeeds",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.anasalnaas.gooddeeds"
    },
    "android": {
      "package": "com.anasalnaas.gooddeeds",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#103048",
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "backgroundImage": "./assets/brand/android-icon-background.png",
        "monochromeImage": "./assets/brand/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 110
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
