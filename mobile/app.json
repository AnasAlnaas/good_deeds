{
  "expo": {
    "name": "Good Deeds",
    "slug": "good-deeds",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "gooddeeds",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.islahtarbawi.gooddeeds",
      "infoPlist": {
        "ExpoLocalization_supportsRTL": false
      }
    },
    "android": {
      "package": "com.islahtarbawi.gooddeeds",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#103048",
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "backgroundImage": "./assets/brand/android-icon-background.png",
        "monochromeImage": "./assets/brand/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 110
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#103048",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96f191ca-ab90-4b32-b12d-fd1bad262292"
      }
    },
    "owner": "anasalnaas"
  }
}
