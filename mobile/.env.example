# Copy to .env.local (not committed) for a build that talks to the real server.
# Both values end up inside the app, so nothing here is secret.

# The API's address on Vercel (docs/deploy-vercel.md), e.g.
# https://good-deeds-api.vercel.app
# Empty: development finds the server on this computer; a test APK has only the offline demo.
EXPO_PUBLIC_API_URL=

# The published privacy policy (docs/privacy-*.md). Empty = no link in Settings.
EXPO_PUBLIC_PRIVACY_URL=

# Crash and error reports (src/data/crashes.ts): the DSN of the Sentry project
# (sentry.io, Settings > Projects > the project > Client Keys). It ends up inside
# the app, which is how Sentry is meant to be used. Empty = no reports.
EXPO_PUBLIC_SENTRY_DSN=
